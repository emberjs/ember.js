{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./compiler-options.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    // It'd be really nice to be able to supply sourcemaps, and at some point we
    // will be able to by using e.g. rollup-plugin-ts once we solve other issues
    // blocking that in our publishing pipeline by way of circular and repeated
    // dependencies in the graph, but at the moment we are using `magic-string`
    // to post-process these to add `declare module` declarations (see the
    // `types/publish.mjs` script or details), and that doesn't support updating
    // *existing* source maps, unfortunately.
    "declarationMap": false,
    "declarationDir": "../types/stable"
  },
  // gxt-ambient.d.ts declares the `__GXT_MODE__` build constant the classic
  // packages' GXT hooks read.
  "include": ["../packages/**/*.ts", "../types/gxt-ambient.d.ts"],
  "exclude": [
    "../**/type-tests",
    "../**/tests",
    "../**/@glimmer/*/test",
    "../**/@glimmer-workspace/*/test",
    "../**/internal-test-helpers",

    // @glimmer/component publishes as its own real package
    "../**/@glimmer/component",

    // glimmer-vm packages that are not historically exposed
    "../**/@glimmer-workspace/integration-tests/**/*.ts",
    "../**/@glimmer-workspace/test-utils/**/*.ts",
    "../**/@glimmer/debug-util/**/*.ts",
    "../**/@glimmer/encoder/**/*.ts",
    "../**/@glimmer/env/**/*.ts",
    "../**/@glimmer/local-debug-flags/**/*.ts",

    // The GXT backends are not public API. The compat backend is reached only
    // through gxt-bridge (imported by the classic packages, so tsc still emits
    // it); the gxt-native layer only through the gxt-native build's module
    // aliases (scripts/gxt-alias-map.mjs). @glimmer/component-gxt is a GXT
    // test/compat package.
    "../**/@ember/-internals/gxt-backend/**/*.ts",
    "../**/@glimmer/component-gxt/**/*.ts"
  ]
}
